VITE_API_BASE_URL=/api/v1
# Set this only after the real backend address is confirmed.
API_PROXY_TARGET=
# Set to 1 in .env.local to connect the real Alpha single-user demo in Vite dev.
VITE_LOCAL_DEMO_MATTERS=0
# Complete Agent HTTP flow budget, including extraction and planning.
VITE_AGENT_RUN_TIMEOUT_SECONDS=420
