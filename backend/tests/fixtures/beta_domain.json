  "rules": {
    "GR-01": {
      "source": "recommendation",
      "anchor": "rank",
      "title": "校内学业排名和课程条件",
      "expected": "本专业同年级学业排名前35%且无补考或重修，或前20%且至多1门补考或重修。两条路径均要求纳入学业综合成绩的应修课已获学分。",
      "review": "排名口径、同年级本专业分母和补考重修记录以教务材料核对。",
      "related_anchors": ["credits"],
      "rank_paths": [
        {
          "max_percentile": 35,
          "max_makeup_or_repeat_courses": 0
        },
        {
          "max_percentile": 20,
          "max_makeup_or_repeat_courses": 1
        }
      ]
    },
    "GR-02": {
      "source": "recommendation",
