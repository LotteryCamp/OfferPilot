digraph ER {
    graph [rankdir=TB, splines=ortho, nodesep=0.12, ranksep=0.30,
           fontname="Microsoft YaHei", bgcolor="white", pad="0.2"];
    node  [fontname="Microsoft YaHei", shape=plaintext];
    edge  [fontname="Microsoft YaHei", fontsize=10, color="#5B6B85",
           dir=both, arrowtail=tee, arrowhead=crow, penwidth=1.2];

    "core.app_user" [shape=plaintext, fontsize=15, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#1F3A5F" BGCOLOR="white"><TR><TD WIDTH="162" BGCOLOR="#EDF3FB" ALIGN="CENTER"><FONT COLOR="#1F3A5F">用户<BR/>app_user</FONT></TD><TD BGCOLOR="#EDF3FB"></TD><TD BGCOLOR="#EDF3FB"></TD></TR><TR><TD ALIGN="LEFT" PORT="id">id</TD><TD WIDTH="14"></TD><TD ALIGN="LEFT">PK</TD></TR><TR><TD ALIGN="LEFT" PORT="email">email</TD><TD WIDTH="14"></TD><TD ALIGN="LEFT">UK</TD></TR><TR><TD ALIGN="LEFT" PORT="status">status</TD><TD WIDTH="14"></TD><TD ALIGN="LEFT"></TD></TR></TABLE>>];
    "core.personal_document" [shape=plaintext, fontsize=15, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#1F3A5F" BGCOLOR="white"><TR><TD WIDTH="162" BGCOLOR="#EDF3FB" ALIGN="CENTER"><FONT COLOR="#1F3A5F">个人材料<BR/>personal_document</FONT></TD><TD BGCOLOR="#EDF3FB"></TD><TD BGCOLOR="#EDF3FB"></TD></TR><TR><TD ALIGN="LEFT" PORT="id">id</TD><TD WIDTH="14"></TD><TD ALIGN="LEFT">PK</TD></TR><TR><TD ALIGN="LEFT" PORT="user_id">user_id</TD><TD WIDTH="14"></TD><TD ALIGN="LEFT">FK</TD></TR><TR><TD ALIGN="LEFT" PORT="category">category</TD><TD WIDTH="14"></TD><TD ALIGN="LEFT"></TD></TR></TABLE>>];
    "core.document_version" [shape=plaintext, fontsize=15, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#1F3A5F" BGCOLOR="white"><TR><TD WIDTH="162" BGCOLOR="#EDF3FB" ALIGN="CENTER"><FONT COLOR="#1F3A5F">个人材料版本<BR/>document_version</FONT></TD><TD BGCOLOR="#EDF3FB"></TD><TD BGCOLOR="#EDF3FB"></TD></TR><TR><TD ALIGN="LEFT" PORT="id">id</TD><TD WIDTH="14"></TD><TD ALIGN="LEFT">PK</TD></TR><TR><TD ALIGN="LEFT" PORT="doc_id">doc_id</TD><TD WIDTH="14"></TD><TD ALIGN="LEFT">FK</TD></TR><TR><TD ALIGN="LEFT" PORT="valid_until">valid_until</TD><TD WIDTH="14"></TD><TD ALIGN="LEFT"></TD></TR></TABLE>>];
    "core.document_usage" [shape=plaintext, fontsize=15, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#1F3A5F" BGCOLOR="white"><TR><TD WIDTH="162" BGCOLOR="#EDF3FB" ALIGN="CENTER"><FONT COLOR="#1F3A5F">个人材料引用<BR/>document_usage</FONT></TD><TD BGCOLOR="#EDF3FB"></TD><TD BGCOLOR="#EDF3FB"></TD></TR><TR><TD ALIGN="LEFT" PORT="id">id</TD><TD WIDTH="14"></TD><TD ALIGN="LEFT">PK</TD></TR><TR><TD ALIGN="LEFT" PORT="version_id">version_id</TD><TD WIDTH="14"></TD><TD ALIGN="LEFT">FK</TD></TR><TR><TD ALIGN="LEFT" PORT="matter_id">matter_id</TD><TD WIDTH="14"></TD><TD ALIGN="LEFT">FK</TD></TR><TR><TD ALIGN="LEFT" PORT="frozen">frozen</TD><TD WIDTH="14"></TD><TD ALIGN="LEFT"></TD></TR></TABLE>>];
    "core.fact" [shape=plaintext, fontsize=15, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#1F3A5F" BGCOLOR="white"><TR><TD WIDTH="162" BGCOLOR="#EDF3FB" ALIGN="CENTER"><FONT COLOR="#1F3A5F">事实<BR/>fact</FONT></TD><TD BGCOLOR="#EDF3FB"></TD><TD BGCOLOR="#EDF3FB"></TD></TR><TR><TD ALIGN="LEFT" PORT="id">id</TD><TD WIDTH="14"></TD><TD ALIGN="LEFT">PK</TD></TR><TR><TD ALIGN="LEFT" PORT="owner_id">owner_id</TD><TD WIDTH="14"></TD><TD ALIGN="LEFT">FK</TD></TR><TR><TD ALIGN="LEFT" PORT="confirm_status">confirm_status</TD><TD WIDTH="14"></TD><TD ALIGN="LEFT"></TD></TR></TABLE>>];
    "core.fact_grant" [shape=plaintext, fontsize=15, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#1F3A5F" BGCOLOR="white"><TR><TD WIDTH="162" BGCOLOR="#EDF3FB" ALIGN="CENTER"><FONT COLOR="#1F3A5F">事实授权<BR/>fact_grant</FONT></TD><TD BGCOLOR="#EDF3FB"></TD><TD BGCOLOR="#EDF3FB"></TD></TR><TR><TD ALIGN="LEFT" PORT="id">id</TD><TD WIDTH="14"></TD><TD ALIGN="LEFT">PK</TD></TR><TR><TD ALIGN="LEFT" PORT="fact_id">fact_id</TD><TD WIDTH="14"></TD><TD ALIGN="LEFT">FK</TD></TR><TR><TD ALIGN="LEFT" PORT="purpose">purpose</TD><TD WIDTH="14"></TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT" PORT="status">status</TD><TD WIDTH="14"></TD><TD ALIGN="LEFT"></TD></TR></TABLE>>];
    "core.model_transfer_consent" [shape=plaintext, fontsize=15, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#1F3A5F" BGCOLOR="white"><TR><TD WIDTH="162" BGCOLOR="#EDF3FB" ALIGN="CENTER"><FONT COLOR="#1F3A5F">模型传输同意<BR/>model_transfer_consent</FONT></TD><TD BGCOLOR="#EDF3FB"></TD><TD BGCOLOR="#EDF3FB"></TD></TR><TR><TD ALIGN="LEFT" PORT="id">id</TD><TD WIDTH="14"></TD><TD ALIGN="LEFT">PK</TD></TR><TR><TD ALIGN="LEFT" PORT="user_id">user_id</TD><TD WIDTH="14"></TD><TD ALIGN="LEFT">FK</TD></TR><TR><TD ALIGN="LEFT" PORT="provider">provider</TD><TD WIDTH="14"></TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT" PORT="status">status</TD><TD WIDTH="14"></TD><TD ALIGN="LEFT"></TD></TR></TABLE>>];

    "core.app_user" -> "core.personal_document" [label="持有"];
    "core.document_version" -> "core.personal_document";
    "core.personal_document" -> "core.document_version" [label="版本化"];
    "core.personal_document" -> "core.document_usage";
    "core.document_version" -> "core.document_usage" [label="引用"];
    "core.app_user" -> "core.fact";
    "core.personal_document" -> "core.fact" [label="依据"];
    "core.fact" -> "core.fact_grant" [label="授权"];
    "core.app_user" -> "core.model_transfer_consent" [label="同意"];
}
