---
config:
  theme: base
  themeCSS: 'text.messageText { paint-order: stroke; stroke: white; stroke-width: 5px; stroke-linejoin: round; }'
  themeVariables:
    fontFamily: "Microsoft YaHei, sans-serif"
    fontSize: "21px"
    primaryColor: "#EDF4FE"
    primaryBorderColor: "#83A0C1"
    primaryTextColor: "#19354D"
    secondaryColor: "#EBF6F1"
    tertiaryColor: "#F5F8FC"
    lineColor: "#55708D"
    edgeLabelBackground: "#FFFFFF"
    clusterBkg: "#F4F8FC"
    clusterBorder: "#B3C8DC"
    actorBkg: "#EDF4FE"
    actorBorder: "#8DAAC8"
    actorTextColor: "#19354D"
    actorLineColor: "#B8CBDE"
    signalColor: "#294E70"
    signalTextColor: "#19354D"
    labelBoxBkgColor: "#EBF6F1"
    labelBoxBorderColor: "#9ABBAE"
    loopTextColor: "#19354D"
    actorFontSize: "20px"
    messageFontSize: "19px"
    sequenceNumberColor: "#FFFFFF"
  flowchart:
    curve: linear
    wrappingWidth: 300
    nodeSpacing: 45
    rankSpacing: 52
  sequence:
    mirrorActors: true
    actorMargin: 60
    messageMargin: 25
    boxMargin: 12
---
flowchart TB
    S([开始]) --> R["查官方通知，读正文和附件"]
    R --> C["提取要求，程序自动检查"]
    C --> Q{"规则与数据可用？"}
    Q -->|"缺个人数据"| P["待补充信息"]
    Q -->|"规则存疑"| H["待用户核对"]
    Q -->|"可判断"| V["按现有信息符合<br/>或按现有信息不符合"]
    P --> E["暂停该条判断<br/>补充或核对后复查"]
    H --> E
    E -. 其余条目可继续 .-> N
    V --> N["展示依据与候选计划"]
    N --> J{"用户确认？"}
    J -->|"确认且版本有效"| W["写入个人任务"]
    J -->|"暂不确认"| D["保留候选计划"]
    W --> X([展示实际结果])
    classDef core fill:#E7F0FF,stroke:#7196C3
    classDef wait fill:#FFF3E2,stroke:#C09B68
    class R,C,N,W core
    class P,H,E,D wait
