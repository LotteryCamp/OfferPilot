---
config:
  theme: base
  themeCSS: 'text.messageText { paint-order: stroke; stroke: white; stroke-width: 5px; stroke-linejoin: round; }'
  themeVariables:
    fontFamily: "Microsoft YaHei, sans-serif"
    fontSize: "21px"
    primaryColor: "#EDF4FE"
    primaryBorderColor: "#83A0C1"
    primaryTextColor: "#19354D"
    secondaryColor: "#EBF6F1"
    tertiaryColor: "#F5F8FC"
    lineColor: "#55708D"
    edgeLabelBackground: "#FFFFFF"
    clusterBkg: "#F4F8FC"
    clusterBorder: "#B3C8DC"
    actorBkg: "#EDF4FE"
    actorBorder: "#8DAAC8"
    actorTextColor: "#19354D"
    actorLineColor: "#B8CBDE"
    signalColor: "#294E70"
    signalTextColor: "#19354D"
    labelBoxBkgColor: "#EBF6F1"
    labelBoxBorderColor: "#9ABBAE"
    loopTextColor: "#19354D"
    actorFontSize: "20px"
    messageFontSize: "19px"
    sequenceNumberColor: "#FFFFFF"
  flowchart:
    curve: linear
    wrappingWidth: 300
    nodeSpacing: 45
    rankSpacing: 52
  sequence:
    mirrorActors: true
    actorMargin: 60
    messageMargin: 25
    boxMargin: 12
---
flowchart TB
    U["个人工作区"] <--> B["业务服务<br/>身份、版本、确认"]
    B <--> A["Agent 编排器"]
    A <-->|单独核验本次传输同意| M["外部模型"]
    A <--> G["受控工具"]
    subgraph TOOLS["工具能力"]
    R["检索与解析<br/>读正文、附件"]
    C["自动检查<br/>计算与四态自查"]
    W["任务与材料操作<br/>通过业务服务写入"]
    end
    G --> TOOLS
    R --> S[("官方来源与历史版本")]
    classDef core fill:#E7F0FF,stroke:#7196C3
    classDef tools fill:#E9F6F0,stroke:#77A994
    class U,B,A,G core
    class R,C,W,S tools
