digraph ER {
    graph [rankdir=TB, splines=ortho, nodesep=0.12, ranksep=0.30,
           fontname="Microsoft YaHei", bgcolor="white", pad="0.2"];
    node  [fontname="Microsoft YaHei", shape=plaintext];
    edge  [fontname="Microsoft YaHei", fontsize=10, color="#5B6B85",
           dir=both, arrowtail=tee, arrowhead=crow, penwidth=1.2];

    "core.material" [shape=plaintext, fontsize=15, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#1F3A5F" BGCOLOR="white"><TR><TD WIDTH="162" BGCOLOR="#EDF3FB" ALIGN="CENTER"><FONT COLOR="#1F3A5F">事项材料<BR/>material</FONT></TD><TD BGCOLOR="#EDF3FB"></TD><TD BGCOLOR="#EDF3FB"></TD></TR><TR><TD ALIGN="LEFT" PORT="id">id</TD><TD WIDTH="14"></TD><TD ALIGN="LEFT">PK</TD></TR><TR><TD ALIGN="LEFT" PORT="matter_id">matter_id</TD><TD WIDTH="14"></TD><TD ALIGN="LEFT">FK</TD></TR><TR><TD ALIGN="LEFT" PORT="material_type">material_type</TD><TD WIDTH="14"></TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT" PORT="current_version_id">current_version_id</TD><TD WIDTH="14"></TD><TD ALIGN="LEFT">FK</TD></TR></TABLE>>];
    "core.material_version" [shape=plaintext, fontsize=15, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#1F3A5F" BGCOLOR="white"><TR><TD WIDTH="162" BGCOLOR="#EDF3FB" ALIGN="CENTER"><FONT COLOR="#1F3A5F">材料版本<BR/>material_version</FONT></TD><TD BGCOLOR="#EDF3FB"></TD><TD BGCOLOR="#EDF3FB"></TD></TR><TR><TD ALIGN="LEFT" PORT="id">id</TD><TD WIDTH="14"></TD><TD ALIGN="LEFT">PK</TD></TR><TR><TD ALIGN="LEFT" PORT="material_id">material_id</TD><TD WIDTH="14"></TD><TD ALIGN="LEFT">FK</TD></TR><TR><TD ALIGN="LEFT" PORT="status">status</TD><TD WIDTH="14"></TD><TD ALIGN="LEFT"></TD></TR></TABLE>>];
    "core.candidate_plan" [shape=plaintext, fontsize=15, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#1F3A5F" BGCOLOR="white"><TR><TD WIDTH="162" BGCOLOR="#EDF3FB" ALIGN="CENTER"><FONT COLOR="#1F3A5F">候选计划<BR/>candidate_plan</FONT></TD><TD BGCOLOR="#EDF3FB"></TD><TD BGCOLOR="#EDF3FB"></TD></TR><TR><TD ALIGN="LEFT" PORT="id">id</TD><TD WIDTH="14"></TD><TD ALIGN="LEFT">PK</TD></TR><TR><TD ALIGN="LEFT" PORT="matter_id">matter_id</TD><TD WIDTH="14"></TD><TD ALIGN="LEFT">FK</TD></TR><TR><TD ALIGN="LEFT" PORT="op_id">op_id</TD><TD WIDTH="14"></TD><TD ALIGN="LEFT">UK</TD></TR></TABLE>>];
    "core.task" [shape=plaintext, fontsize=15, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#1F3A5F" BGCOLOR="white"><TR><TD WIDTH="162" BGCOLOR="#EDF3FB" ALIGN="CENTER"><FONT COLOR="#1F3A5F">任务<BR/>task</FONT></TD><TD BGCOLOR="#EDF3FB"></TD><TD BGCOLOR="#EDF3FB"></TD></TR><TR><TD ALIGN="LEFT" PORT="id">id</TD><TD WIDTH="14"></TD><TD ALIGN="LEFT">PK</TD></TR><TR><TD ALIGN="LEFT" PORT="plan_id">plan_id</TD><TD WIDTH="14"></TD><TD ALIGN="LEFT">FK</TD></TR><TR><TD ALIGN="LEFT" PORT="status">status</TD><TD WIDTH="14"></TD><TD ALIGN="LEFT"></TD></TR></TABLE>>];
    "core.submission_evidence" [shape=plaintext, fontsize=15, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#1F3A5F" BGCOLOR="white"><TR><TD WIDTH="162" BGCOLOR="#EDF3FB" ALIGN="CENTER"><FONT COLOR="#1F3A5F">提交证据<BR/>submission_evidence</FONT></TD><TD BGCOLOR="#EDF3FB"></TD><TD BGCOLOR="#EDF3FB"></TD></TR><TR><TD ALIGN="LEFT" PORT="id">id</TD><TD WIDTH="14"></TD><TD ALIGN="LEFT">PK</TD></TR><TR><TD ALIGN="LEFT" PORT="matter_id">matter_id</TD><TD WIDTH="14"></TD><TD ALIGN="LEFT">FK</TD></TR><TR><TD ALIGN="LEFT" PORT="evidence_kind">evidence_kind</TD><TD WIDTH="14"></TD><TD ALIGN="LEFT"></TD></TR></TABLE>>];
    "core.official_result" [shape=plaintext, fontsize=15, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#1F3A5F" BGCOLOR="white"><TR><TD WIDTH="162" BGCOLOR="#EDF3FB" ALIGN="CENTER"><FONT COLOR="#1F3A5F">官方结果<BR/>official_result</FONT></TD><TD BGCOLOR="#EDF3FB"></TD><TD BGCOLOR="#EDF3FB"></TD></TR><TR><TD ALIGN="LEFT" PORT="id">id</TD><TD WIDTH="14"></TD><TD ALIGN="LEFT">PK</TD></TR><TR><TD ALIGN="LEFT" PORT="evidence_id">evidence_id</TD><TD WIDTH="14"></TD><TD ALIGN="LEFT">FK</TD></TR><TR><TD ALIGN="LEFT" PORT="result_type">result_type</TD><TD WIDTH="14"></TD><TD ALIGN="LEFT"></TD></TR></TABLE>>];

    "core.material_version" -> "core.material";
    "core.material" -> "core.material_version" [label="版本化"];
    "core.candidate_plan" -> "core.task" [label="写入"];
    "core.submission_evidence" -> "core.official_result" [label="支撑"];
}
