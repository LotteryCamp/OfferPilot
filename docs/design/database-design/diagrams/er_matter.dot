digraph ER {
    graph [rankdir=TB, splines=ortho, nodesep=0.12, ranksep=0.30,
           fontname="Microsoft YaHei", bgcolor="white", pad="0.2"];
    node  [fontname="Microsoft YaHei", shape=plaintext];
    edge  [fontname="Microsoft YaHei", fontsize=10, color="#5B6B85",
           dir=both, arrowtail=tee, arrowhead=crow, penwidth=1.2];

    "core.app_user" [shape=plaintext, fontsize=15, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#1F3A5F" BGCOLOR="white"><TR><TD WIDTH="162" BGCOLOR="#EDF3FB" ALIGN="CENTER"><FONT COLOR="#1F3A5F">用户<BR/>app_user</FONT></TD><TD BGCOLOR="#EDF3FB"></TD><TD BGCOLOR="#EDF3FB"></TD></TR><TR><TD ALIGN="LEFT" PORT="id">id</TD><TD WIDTH="14"></TD><TD ALIGN="LEFT">PK</TD></TR><TR><TD ALIGN="LEFT" PORT="email">email</TD><TD WIDTH="14"></TD><TD ALIGN="LEFT">UK</TD></TR><TR><TD ALIGN="LEFT" PORT="status">status</TD><TD WIDTH="14"></TD><TD ALIGN="LEFT"></TD></TR></TABLE>>];
    "core.workspace" [shape=plaintext, fontsize=15, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#1F3A5F" BGCOLOR="white"><TR><TD WIDTH="162" BGCOLOR="#EDF3FB" ALIGN="CENTER"><FONT COLOR="#1F3A5F">个人工作区<BR/>workspace</FONT></TD><TD BGCOLOR="#EDF3FB"></TD><TD BGCOLOR="#EDF3FB"></TD></TR><TR><TD ALIGN="LEFT" PORT="id">id</TD><TD WIDTH="14"></TD><TD ALIGN="LEFT">PK</TD></TR><TR><TD ALIGN="LEFT" PORT="owner_id">owner_id</TD><TD WIDTH="14"></TD><TD ALIGN="LEFT">FK</TD></TR></TABLE>>];
    "core.matter_type" [shape=plaintext, fontsize=15, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#1F3A5F" BGCOLOR="white"><TR><TD WIDTH="162" BGCOLOR="#EDF3FB" ALIGN="CENTER"><FONT COLOR="#1F3A5F">事项类型<BR/>matter_type</FONT></TD><TD BGCOLOR="#EDF3FB"></TD><TD BGCOLOR="#EDF3FB"></TD></TR><TR><TD ALIGN="LEFT" PORT="id">id</TD><TD WIDTH="14"></TD><TD ALIGN="LEFT">PK</TD></TR><TR><TD ALIGN="LEFT" PORT="type_code">type_code</TD><TD WIDTH="14"></TD><TD ALIGN="LEFT">UK</TD></TR><TR><TD ALIGN="LEFT" PORT="built_in">built_in</TD><TD WIDTH="14"></TD><TD ALIGN="LEFT"></TD></TR></TABLE>>];
    "core.template" [shape=plaintext, fontsize=15, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#1F3A5F" BGCOLOR="white"><TR><TD WIDTH="162" BGCOLOR="#EDF3FB" ALIGN="CENTER"><FONT COLOR="#1F3A5F">事项模板<BR/>template</FONT></TD><TD BGCOLOR="#EDF3FB"></TD><TD BGCOLOR="#EDF3FB"></TD></TR><TR><TD ALIGN="LEFT" PORT="id">id</TD><TD WIDTH="14"></TD><TD ALIGN="LEFT">PK</TD></TR><TR><TD ALIGN="LEFT" PORT="type_code">type_code</TD><TD WIDTH="14"></TD><TD ALIGN="LEFT">FK</TD></TR><TR><TD ALIGN="LEFT" PORT="current_version_id">current_version_id</TD><TD WIDTH="14"></TD><TD ALIGN="LEFT">FK</TD></TR></TABLE>>];
    "core.template_version" [shape=plaintext, fontsize=15, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#1F3A5F" BGCOLOR="white"><TR><TD WIDTH="162" BGCOLOR="#EDF3FB" ALIGN="CENTER"><FONT COLOR="#1F3A5F">模板版本<BR/>template_version</FONT></TD><TD BGCOLOR="#EDF3FB"></TD><TD BGCOLOR="#EDF3FB"></TD></TR><TR><TD ALIGN="LEFT" PORT="id">id</TD><TD WIDTH="14"></TD><TD ALIGN="LEFT">PK</TD></TR><TR><TD ALIGN="LEFT" PORT="template_id">template_id</TD><TD WIDTH="14"></TD><TD ALIGN="LEFT">FK</TD></TR><TR><TD ALIGN="LEFT" PORT="version_no">version_no</TD><TD WIDTH="14"></TD><TD ALIGN="LEFT"></TD></TR></TABLE>>];
    "core.matter" [shape=plaintext, fontsize=15, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#1F3A5F" BGCOLOR="white"><TR><TD WIDTH="162" BGCOLOR="#EDF3FB" ALIGN="CENTER"><FONT COLOR="#1F3A5F">事项<BR/>matter</FONT></TD><TD BGCOLOR="#EDF3FB"></TD><TD BGCOLOR="#EDF3FB"></TD></TR><TR><TD ALIGN="LEFT" PORT="id">id</TD><TD WIDTH="14"></TD><TD ALIGN="LEFT">PK</TD></TR><TR><TD ALIGN="LEFT" PORT="workspace_id">workspace_id</TD><TD WIDTH="14"></TD><TD ALIGN="LEFT">FK</TD></TR><TR><TD ALIGN="LEFT" PORT="status">status</TD><TD WIDTH="14"></TD><TD ALIGN="LEFT"></TD></TR></TABLE>>];
    "core.stage" [shape=plaintext, fontsize=15, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#1F3A5F" BGCOLOR="white"><TR><TD WIDTH="162" BGCOLOR="#EDF3FB" ALIGN="CENTER"><FONT COLOR="#1F3A5F">阶段<BR/>stage</FONT></TD><TD BGCOLOR="#EDF3FB"></TD><TD BGCOLOR="#EDF3FB"></TD></TR><TR><TD ALIGN="LEFT" PORT="id">id</TD><TD WIDTH="14"></TD><TD ALIGN="LEFT">PK</TD></TR><TR><TD ALIGN="LEFT" PORT="matter_id">matter_id</TD><TD WIDTH="14"></TD><TD ALIGN="LEFT">FK</TD></TR><TR><TD ALIGN="LEFT" PORT="seq">seq</TD><TD WIDTH="14"></TD><TD ALIGN="LEFT"></TD></TR></TABLE>>];
    "core.matter_decision" [shape=plaintext, fontsize=15, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#1F3A5F" BGCOLOR="white"><TR><TD WIDTH="162" BGCOLOR="#EDF3FB" ALIGN="CENTER"><FONT COLOR="#1F3A5F">事项决定<BR/>matter_decision</FONT></TD><TD BGCOLOR="#EDF3FB"></TD><TD BGCOLOR="#EDF3FB"></TD></TR><TR><TD ALIGN="LEFT" PORT="id">id</TD><TD WIDTH="14"></TD><TD ALIGN="LEFT">PK</TD></TR><TR><TD ALIGN="LEFT" PORT="matter_id">matter_id</TD><TD WIDTH="14"></TD><TD ALIGN="LEFT">FK</TD></TR><TR><TD ALIGN="LEFT" PORT="decision_value">decision_value</TD><TD WIDTH="14"></TD><TD ALIGN="LEFT"></TD></TR></TABLE>>];

    "core.app_user" -> "core.workspace" [label="拥有"];
    "core.matter_type" -> "core.template" [label="归类"];
    "core.template_version" -> "core.template";
    "core.template" -> "core.template_version" [label="版本化"];
    "core.workspace" -> "core.matter" [label="容纳"];
    "core.matter_type" -> "core.matter";
    "core.template_version" -> "core.matter" [label="实例化"];
    "core.matter" -> "core.matter";
    "core.matter" -> "core.stage" [label="展开"];
    "core.matter" -> "core.matter_decision" [label="记录"];
}
